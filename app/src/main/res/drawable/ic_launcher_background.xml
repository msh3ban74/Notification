        </aapt:attr>
    </path>
    <!-- Soft sheen in the top-left corner for depth -->
    <path android:pathData="M0,0 L64,0 C40,18 18,40 0,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="46"
                android:endY="46"
                android:type="linear">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
