  app's Primary/PrimaryDark/cyan brand colors (ui/theme/Color.kt).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1E3A8A" />
                <item android:offset="0.55" android:color="#FF2563EB" />
                <item android:offset="1.0" android:color="#FF06B6D4" />
