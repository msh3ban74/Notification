rules_version = '2';

// Rafeeq — Firestore security rules.
//
// The whole cloud backup lives under users/{uid}. A signed-in user may
// read and write ONLY their own document and everything nested beneath it
// (reminders, persons, ledger, gam3iyas, financial items, habits, …).
// Nobody can read or write anyone else's data, and unauthenticated
// requests are denied entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Every nested collection inherits the same owner-only rule.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Anything not matched above is denied by default.
  }
}
